OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODEL_2=llama3.1:8b
OLLAMA_JUDGE_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Provider: ollama (default) or gemini
LLM_PROVIDER=ollama
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Executor: retries per step and LLM repair of failed steps (1 = on)
EXECUTOR_MAX_STEP_RETRIES=2
EXECUTOR_REPAIR=1
# Seconds before a math tool call is abandoned
MATH_TOOL_TIMEOUT_SECONDS=10
